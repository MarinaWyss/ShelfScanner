SUPABASE_URL=
SUPABASE_SECRET_KEY=
OPENROUTER_API_KEY=
# Direct provider adapters (change 002). Each is only needed when a model in
# config/models.toml names that adapter.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Model-calling commands refuse to run once the runs tables sum past this
# amount since settings.spend_since in config (change 002, task 0).
SHELFSCANNER_SPEND_CAP_USD=
# Days a session photo is kept before the retention job deletes the object (008); default 30.
SHELFSCANNER_RETENTION_DAYS=
